# 复制为 .env.local 后按需修改（.env.local 不入库）

# ——— 验证码 ———
# Phase 0：simple（自研图形码，仅 Mock / 本地可用）
# Phase 1：turnstile（Cloudflare Turnstile，正式上线必须切换）
VITE_CAPTCHA_PROVIDER=simple
CAPTCHA_PROVIDER=simple
# Phase 1 才需要（前端公钥 + 服务端私钥）
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ——— 管理员 ———
# 用该邮箱注册的账号自动获得 admin 角色
ADMIN_EMAIL=you@example.com

# ——— 会话签名（Phase 0 Mock 也用，务必换成随机长串）———
JWT_SECRET=change-me-to-a-long-random-string
