# 复制为 .env.local 后按需修改（.env.local 不入库）

# ——— 上线模式 ———
# true（默认）：完整模式，登录 / 评论 / 建议 / 管理后台可用（需要后端）
# false：纯攻略模式，隐藏全部用户功能入口（静态托管、无后端时使用）
VITE_ENABLE_USER_FEATURES=true

# ——— 后端模式 ———
# true = 使用 Vite 内置 Mock（Phase 0，零后端依赖）
# false = /api 代理到 server/ 的 Fastify 真后端（Phase 1）
USE_MOCK_API=true
API_PROXY_TARGET=http://127.0.0.1:3001
# 留空 = 同源（走 Vite 代理）；直连后端时填完整地址
VITE_API_BASE_URL=

# ——— 验证码 ———
# Phase 0：simple（自研图形码，仅 Mock / 本地可用）
# Phase 1：turnstile（Cloudflare Turnstile，正式上线必须切换）
VITE_CAPTCHA_PROVIDER=simple
CAPTCHA_PROVIDER=simple
# Phase 1 才需要（前端公钥 + 服务端私钥）
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ——— 管理员 ———
# 用该邮箱注册的账号自动获得 admin 角色
ADMIN_EMAIL=you@example.com

# ——— 会话签名（Phase 0 Mock 也用，务必换成随机长串）———
JWT_SECRET=change-me-to-a-long-random-string
